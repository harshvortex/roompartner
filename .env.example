# RoomPartner v8 — copy to .env.local and fill in. Leave blank for demo mode.
# Rate limiting is in-memory per instance (middleware + lib/rateLimit.ts):
# payments 10/min/IP, other APIs 60/min/IP. For a strict global limit use
# Upstash Redis / Vercel KV instead — see README "Production hardening".
# Demo mode (all blank): seed data + localStorage, simulated OTP, demo payments.

# Supabase (Auth + Postgres + Realtime) — required for live auth/chat
# Create a project at https://supabase.com, then:
#  - Enable Google provider (Auth → Providers → Google) with your OAuth keys
#  - Enable Phone provider (Auth → Providers → Phone) with your SMS provider (MSG91/DLT)
#  - Run supabase/schema.sql in the SQL Editor
#  - Database → Replication → enable the `messages` table for Realtime
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay — TEST MODE ONLY. Use test keys (rzp_test_*).
# Live keys (rzp_live_*) are REFUSED by /api/payments/create-order until
# Razorpay business KYC is complete. Never put the secret in NEXT_PUBLIC_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Public app URL (used for the Google OAuth redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000
